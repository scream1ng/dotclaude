{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "lean-ctx hook rewrite"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": false,
    "railway@claude-plugins-official": false,
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": false,
    "cloudflare@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "terminalProgressBarEnabled": true,
  "mcpServers": {
    "railway": {
      "type": "npx",
      "command": "npx",
      "args": [
        "-y",
        "@railway/mcp-server@latest"
      ],
      "disabled": true
    }
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\oakkySAMA\\.claude\\statusline.ps1\""
  }
}
